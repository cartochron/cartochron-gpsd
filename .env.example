# Use your actual LAN interface IP to accept NMEA feeds from trusted phones.
# Loopback is the safe default; never expose UDP input ports to the Internet.
GPSD_BIND_IP=127.0.0.1
GPSD_UDP_PORT_RANGE=29998-30017

# Cartochron's private user:password file (from its Compose setup).
CARTOCHRON_AUTH_FILE=../cartochron/data/auth
CARTOCHRON_ENDPOINT=http://127.0.0.1:8765/api/position

# The collector reads the 0600 auth file as this host user/group.
COLLECTOR_UID=1000
COLLECTOR_GID=1000
