# Each UDP port identifies a GPSD input CHANNEL, not a verified phone.
# Experiments can leave source_id blank or omit it entirely.
# After enrolling a permanent Cartochron source, put its src_ ID here.

[sources.oneplus]
device = "udp://*:29998"
source_id = ""

[sources.lg]
device = "udp://*:29999"
source_id = ""
